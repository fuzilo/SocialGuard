# Optional overrides: copy to .env and uncomment only the values you need.
# Otherwise, application.properties supplies the defaults; Compose adjusts hosts.
# An uncommented NAME= sets an empty value, overriding the application default.
# MYSQL_HOST=host.docker.internal
# SPRING_DATASOURCE_URL=jdbc:mysql://host.docker.internal:3306/social_guard?createDatabaseIfNotExist=true
# SPRING_DATASOURCE_USERNAME=your-user
# SPRING_DATASOURCE_PASSWORD=your-password
# RABBITMQ_HOST=host.docker.internal
# RABBITMQ_PORT=5672
# RABBITMQ_USERNAME=your-user
# RABBITMQ_PASSWORD=your-password

# Tracing overrides also need explicit entries in services.api.environment.
# MANAGEMENT_TRACING_EXPORT_OTLP_ENABLED=false
# MANAGEMENT_OPENTELEMETRY_TRACING_EXPORT_OTLP_ENDPOINT=http://host.docker.internal:4318/v1/traces
